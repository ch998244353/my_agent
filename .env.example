# Docker Compose 会自动读取复制后的 .env；MyAgent 本身不会读取 .env 文件。
POSTGRES_DB=myagent
POSTGRES_USER=myagent
POSTGRES_PASSWORD=myagent-local
POSTGRES_HOST_PORT=55432

# 直接运行 MyAgent 时，请把下面这些值导入当前进程环境。
MYAGENT_POSTGRES_DSN=postgresql://myagent:myagent-local@127.0.0.1:55432/myagent
# Planning 创建计划时会冻结这个工作区路径；必须指向已经存在的目录。
MYAGENT_WORKSPACE_ROOT=C:\path\to\my_agent
# Planning 最终验证使用的固定命令；项目已有基线失败时可改为自己的可靠验证入口。
MYAGENT_WORKSPACE_TEST_COMMAND=python scripts/verify_current_baseline.py
MYAGENT_EMBEDDING_MODEL=text-embedding-3-small
MYAGENT_EMBEDDING_DIMENSIONS=1024
MYAGENT_MEMORY_RETRIEVAL_ENABLED=false
MYAGENT_HTTP_HOST=127.0.0.1
MYAGENT_HTTP_PORT=8000
MYAGENT_CORS_ORIGINS=
MYAGENT_RETRIEVAL_TOP_K=8
MYAGENT_MAX_CONTEXT_CHUNKS=4
MYAGENT_MAX_CONTEXT_CHARS=12000
MYAGENT_ALLOW_REAL_MODEL_SMOKE=false
